        "type": "object",
        "required": [
          "product_id",
          "brand",
          "name",
          "tier",
          "size",
          "load_index",
          "speed_rank",
          "speed_symbol",
          "season",
          "price",
          "comfort",
          "wet_grip",
          "store_id",
          "location_name",
          "available_quantity",
          "observed_epoch",
          "age_minutes",
          "distance",
          "lead_days",
          "score",
          "score_contributions",
          "explanation",
          "citation",
          "highlight_keys"

            "minimum": 0.0,
            "title": "Distance"
          },
          "lead_days": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Lead Days"
          },
          "score": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"

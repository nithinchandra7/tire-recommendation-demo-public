  "components": {
    "schemas": {
      "ExecutionStage": {
        "properties": {
          "component": {
            "type": "string",
            "title": "Component"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "duration_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Duration Ms"
          }
        },
        "type": "object",
        "required": [
          "component",
          "label",
          "duration_ms"
        ],
        "title": "ExecutionStage"
      },
      "ExecutionTrace": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "stages": {
            "items": {
              "$ref": "#/components/schemas/ExecutionStage"
            },
            "type": "array",
            "title": "Stages"
          },
          "query_candidate_locations": {
            "type": "integer",
            "title": "Query Candidate Locations"
          },
          "unique_recommendations": {
            "type": "integer",
            "title": "Unique Recommendations"
          },
          "retailer_scope": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Retailer Scope"
          },
          "hard_constraints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hard Constraints"
          },
          "filters": {
            "$ref": "#/components/schemas/Filters"
          },
          "preference_changes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Preference Changes"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Weights"
          },
          "data_version": {
            "type": "string",
            "title": "Data Version"
          },
          "rules_version": {
            "type": "string",
            "title": "Rules Version"
          },
          "as_of": {
            "type": "string",
            "title": "As Of"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "standard",
              "nearby",
              "quantity",
              "stale",
              "no_match",
              "upgrade"
            ],
            "title": "Scenario"
          },
          "simulation": {
            "type": "string",
            "title": "Simulation"
          },
          "total_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Total Ms"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "stages",
          "query_candidate_locations",
          "unique_recommendations",
          "retailer_scope",
          "hard_constraints",
          "filters",
          "preference_changes",
          "weights",
          "data_version",
          "rules_version",
          "as_of",
          "scenario",
          "simulation",
          "total_ms"
        ],
        "title": "ExecutionTrace"
      },
      "Filters": {
        "properties": {
          "vehicle_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^V\\d{2}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Vehicle Id",
            "default": "V01"
          },
          "size": {
            "type": "string",
            "pattern": "^\\d{3}/\\d{2}R\\d{2}$",
            "title": "Size",
            "default": "225/55R17"
          },
          "store_id": {
            "type": "string",
            "pattern": "^S\\d{2}$",
            "title": "Store Id",
            "default": "S01"
          },
          "quantity": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 1.0,
            "title": "Quantity",
            "default": 4
          },
          "budget": {
            "type": "number",
            "maximum": 1000.0,
            "minimum": 25.0,
            "title": "Budget",
            "default": 150
          },
          "min_load_index": {
            "type": "integer",
            "maximum": 130.0,
            "minimum": 75.0,
            "title": "Min Load Index",
            "default": 98
          },
          "min_speed_rank": {
            "type": "integer",
            "maximum": 6.0,
            "minimum": 1.0,
            "title": "Min Speed Rank",
            "default": 4
          },
          "season": {
            "type": "string",
            "enum": [
              "any",
              "all-season",
              "summer",
              "winter"
            ],
            "title": "Season",
            "default": "any"
          },
          "priority": {
            "type": "string",
            "enum": [
              "balanced",
              "comfort",
              "wet",
              "budget"
            ],
            "title": "Priority",
            "default": "balanced"
          },
          "max_lead_days": {
            "type": "integer",
            "maximum": 14.0,
            "minimum": 0.0,
            "title": "Max Lead Days",
            "default": 3
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Filters"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InventoryUpdate": {
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Event Id"
          },
          "product_id": {
            "type": "string",
            "pattern": "^T\\d{4}$",
            "title": "Product Id"
          },
          "store_id": {
            "type": "string",
            "pattern": "^S\\d{2}$",
            "title": "Store Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 0.0,
            "title": "Quantity"
          },
          "observed_epoch": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Observed Epoch"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "product_id",
          "store_id",
          "quantity",
          "observed_epoch"
        ],
        "title": "InventoryUpdate"
      },

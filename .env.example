# SQLite and templates work without any cloud credentials.
DATA_BACKEND=sqlite
AI_PROVIDER=template
DEMO_DATABASE=runtime/tire-demo.sqlite
DEMO_CLOCK=2026-10-11T12:00:00+00:00
INVENTORY_MAX_AGE_MINUTES=30

# Install the cloud extra and explicitly select Snowflake to use these.
SNOWFLAKE_ACCOUNT=YOUR_ORG-YOUR_ACCOUNT
SNOWFLAKE_USER=YOUR_SERVICE_USER
SNOWFLAKE_ROLE=YOUR_ROLE
SNOWFLAKE_WAREHOUSE=YOUR_WAREHOUSE
SNOWFLAKE_DATABASE=YOUR_DATABASE
SNOWFLAKE_SCHEMA=YOUR_SCHEMA
SNOWFLAKE_PRIVATE_KEY_PATH=/path/to/private_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_TEST_ENABLED=0
CORTEX_MODEL=YOUR_SUPPORTED_MODEL

# Optional Azure OpenAI deployment accessed through Foundry.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT
AZURE_OPENAI_API_KEY=YOUR_API_KEY

# Deployment reference placeholders; local identity is explicitly simulated.
AZURE_SUBSCRIPTION_ID=YOUR_SUBSCRIPTION_ID
AZURE_RESOURCE_GROUP=YOUR_RESOURCE_GROUP
AZURE_CONTAINER_APP=YOUR_CONTAINER_APP
ENTRA_TENANT_ID=YOUR_TENANT_ID
ENTRA_CLIENT_ID=YOUR_CLIENT_ID
KEY_VAULT_URI=https://YOUR_VAULT.vault.azure.net
